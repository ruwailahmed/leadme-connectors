{
  "name": "leadme-connectors",
  "version": "1.0.0",
  "description": "Slack + Discord source connectors for leadme \u2014 connect accounts, pick workspaces/channels, attach monitors, get alerts.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "test": "node --test src/*.test.ts",
    "build": "esbuild src/vercel.ts --bundle --platform=node --format=esm --target=node22 --outfile=api/index.js --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\""
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "esbuild": "0.25.0"
  }
}